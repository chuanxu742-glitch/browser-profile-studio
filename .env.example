# Replace this with hosts you own or are explicitly authorized to test.
BROWSER_ALLOWED_HOSTS=test.example.com

# Optional resource allowlist. When omitted, it follows BROWSER_ALLOWED_HOSTS.
# BROWSER_RESOURCE_HOSTS=static.test.example.com

# Keep both disabled unless a reviewed local fixture requires them.
BROWSER_ALLOW_HTTP=false
BROWSER_ALLOW_PRIVATE_NETWORK=false

# Bounded service defaults.
BROWSER_MAX_SESSIONS=2
BROWSER_TIMEOUT_MS=15000
# Absolute lifetime for every browser session (30 minutes by default; the
# server accepts only 1 minute through 24 hours).
BROWSER_SESSION_TTL_MS=1800000

# Administrator-selected automation resource policy. The model cannot change
# this value; it controls effective tab, workflow, snapshot, and TTL ceilings.
# Profiles: strict, standard, trusted-local.
BROWSER_AUTOMATION_POLICY=standard

# Inactive workspace retention. Omit to use the selected policy default.
# BROWSER_WORKSPACE_TTL_MS=604800000

# Process-local MCP request safety valve (sustained rate and burst capacity).
MCP_RATE_PER_SECOND=20
MCP_BURST=40

# Optional server-owned absolute paths.
# BROWSER_DATA_DIR=C:\\compliant-firefox-data
# BROWSER_AUDIT_PATH=C:\\compliant-firefox-data\\audit.jsonl
# Persist only explicitly named profiles across browser/process restarts. This
# stores cookies and local storage; enable only on a protected persistent volume.
BROWSER_PERSIST_PROFILES=false

# Optional HTTP/WS browser control plane (disabled unless started explicitly).
# CONTROL_PLANE_HOST=127.0.0.1
# CONTROL_PLANE_PORT=8081
# CONTROL_PLANE_TOKEN=replace-with-a-long-random-token

# Redis-backed cluster workers/master. Standalone is the default; native Redis
# Cluster is selected with REDIS_MODE=cluster and startup nodes.
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_MODE=standalone
# REDIS_CLUSTER_NODES=redis://127.0.0.1:7000,redis://127.0.0.1:7001,redis://127.0.0.1:7002
# Keep this value identical for the master and every worker.
# REDIS_SHARD_COUNT=16
# WORKER_ID=worker-local
# WORKER_CONCURRENCY=2
# Comma-separated tenant allowlist for this trusted worker.
# WORKER_TENANTS=default

# Optional MCP control-plane authentication. When set, cluster_* calls must
# provide tenantId and a 32+ character tenantToken. Keep secrets in a secret
# manager in production; do not commit this JSON.
# TENANT_CREDENTIALS_JSON={"tenant-a":{"token":"replace-with-a-32-character-secret","roles":["read","submit"]}}
