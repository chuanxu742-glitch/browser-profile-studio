+// found in the LICENSE file.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_GRAPHICS_ABS_CANVAS_NOISE_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_GRAPHICS_ABS_CANVAS_NOISE_H_
+
+#include <utility>
+
+#include "third_party/blink/renderer/platform/abs_profile.h"
+#include "third_party/skia/include/core/SkData.h"
+#include "third_party/skia/include/core/SkImage.h"
+#include "third_party/skia/include/core/SkPixmap.h"
+#include "ui/gfx/skia_span_util.h"
+
+namespace blink::abs_profile {
+
+// Only touches a caller-owned readback copy. Respect rowBytes, RGBA/BGRA byte
+// order and absolute coordinates. Alpha, transparent/partially transparent
+// pixels, HDR formats and exact black/white channels retain their values.
+inline void CanvasPixels(const SkPixmap& pixmap, int origin_x = 0,
+                         int origin_y = 0) {
+  const auto seed = Uint("abs-canvas-seed");
+  const auto type = pixmap.colorType();
+  if (!seed || !pixmap.addr() ||
+      (type != kRGBA_8888_SkColorType && type != kBGRA_8888_SkColorType))
+    return;
+  auto bytes = gfx::SkPixmapToWritableSpan(pixmap);
+  for (int y = 0; y < pixmap.height(); ++y) {
+    auto row = bytes.subspan(static_cast<size_t>(y) * pixmap.rowBytes(),
+                            static_cast<size_t>(pixmap.width()) * 4);
+    for (int x = 0; x < pixmap.width(); ++x) {
+      auto pixel = row.subspan(static_cast<size_t>(x) * 4, 4u);
+      if (pixel[3] != 255)
+        continue;
+      for (unsigned channel = 0; channel < 3; ++channel) {
+        const unsigned byte = type == kBGRA_8888_SkColorType ? 2 - channel : channel;
+        const uint8_t value = pixel[byte];
+        if (value == 0 || value == 255)
+          continue;
+        const uint32_t high_bits = value & ~1u;
+        const uint32_t hash = Mix(*seed ^
+            ((static_cast<uint32_t>(origin_x) + x) * 374761393u) ^
+            ((static_cast<uint32_t>(origin_y) + y) * 668265263u) ^
+            (channel * 0x9e3779b9u) ^ (high_bits * 2654435761u));
+        // Never produce a protected endpoint from a non-endpoint: rereading an
+        // exported image must use the same transform.
+        const uint8_t changed = static_cast<uint8_t>(high_bits | (hash & 1u));
+        pixel[byte] = changed == 0 || changed == 255 ? value : changed;
+      }
+    }
+  }
+}
+
+inline sk_sp<SkImage> CanvasCopy(const SkPixmap& source) {
+  const auto info = source.info().makeAlphaType(kUnpremul_SkAlphaType);
+  const size_t row_bytes = info.minRowBytes();
+  const size_t size = info.computeByteSize(row_bytes);
+  if (info.isEmpty() || SkImageInfo::ByteSizeOverflowed(size))
+    return nullptr;
+  auto data = SkData::MakeUninitialized(size);
+  if (!data || !source.readPixels(info, data->writable_data(), row_bytes))
+    return nullptr;
+  SkPixmap copy(info, data->writable_data(), row_bytes);
+  CanvasPixels(copy);
+  return SkImages::RasterFromData(info, std::move(data), row_bytes);
+}
+
+}  // namespace blink::abs_profile
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_PLATFORM_GRAPHICS_ABS_CANVAS_NOISE_H_
