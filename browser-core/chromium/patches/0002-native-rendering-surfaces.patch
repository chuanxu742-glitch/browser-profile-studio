diff --git a/third_party/blink/renderer/platform/abs_profile.h b/third_party/blink/renderer/platform/abs_profile.h
new file mode 100644
index 0000000..c292d6c
--- /dev/null
+++ b/third_party/blink/renderer/platform/abs_profile.h
@@ -0,0 +1,55 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_ABS_PROFILE_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_ABS_PROFILE_H_
+
+#include <bit>
+#include <cstdint>
+#include <optional>
+#include <string>
+
+#include "base/command_line.h"
+#include "base/strings/string_number_conversions.h"
+
+namespace blink::abs_profile {
+
+// CommandLine is immutable after renderer startup. No shared mutable profile or
+// per-worker setters: worker creation cannot race configuration installation.
+inline std::string Get(const char* name) {
+  return base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(name);
+}
+
+inline std::optional<uint32_t> Uint(const char* name) {
+  uint32_t value;
+  if (!base::StringToUint(Get(name), &value))
+    return std::nullopt;
+  return value;
+}
+
+inline uint32_t Mix(uint32_t value) {
+  value ^= value >> 16;
+  value *= 0x85ebca6bu;
+  value ^= value >> 13;
+  value *= 0xc2b2ae35u;
+  return value ^ (value >> 16);
+}
+
+// Replace two low mantissa bits, rather than adding noise on each read. This
+// is idempotent, preserves silence, NaN/Infinity and subnormal samples, and
+// changes a finite normalized sample by at most three ULPs.
+inline float AudioSample(float value, uint32_t seed, uint32_t index,
+                         uint32_t channel = 0) {
+  uint32_t bits = std::bit_cast<uint32_t>(value);
+  const uint32_t exponent = bits & 0x7f800000u;
+  if (!exponent || exponent == 0x7f800000u)
+    return value;
+  bits &= ~3u;
+  return std::bit_cast<float>(bits | (Mix(seed ^ bits ^
+      (index * 0x9e3779b9u) ^ (channel * 0x165667b1u)) & 3u));
+}
+
+}  // namespace blink::abs_profile
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_PLATFORM_ABS_PROFILE_H_
diff --git a/third_party/blink/renderer/platform/abs_profile_test.cc b/third_party/blink/renderer/platform/abs_profile_test.cc
new file mode 100644
index 0000000..11a757c
--- /dev/null
+++ b/third_party/blink/renderer/platform/abs_profile_test.cc
@@ -0,0 +1,115 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/platform/abs_profile.h"
+#include "third_party/blink/renderer/platform/graphics/abs_canvas_noise.h"
+
+#include <array>
+#include <bit>
+#include <cstdint>
+#include <cstdlib>
+#include <limits>
+
+#include "base/test/scoped_command_line.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace blink {
+namespace {
+
+TEST(AbsProfileTest, SeedZeroIsValidAndMalformedSeedIsAbsent) {
+  base::test::ScopedCommandLine command;
+  command.GetProcessCommandLine()->RemoveSwitch("abs-canvas-seed");
+  EXPECT_FALSE(abs_profile::Uint("abs-canvas-seed"));
+  command.GetProcessCommandLine()->AppendSwitchASCII("abs-canvas-seed", "0");
+  EXPECT_EQ(abs_profile::Uint("abs-canvas-seed"), 0u);
+  command.GetProcessCommandLine()->AppendSwitchASCII("abs-canvas-seed", "bad");
+  EXPECT_FALSE(abs_profile::Uint("abs-canvas-seed"));
+}
+
+TEST(AbsProfileTest, AudioIsIdempotentBoundedAndSeeded) {
+  unsigned differences = 0;
+  for (uint32_t i = 0; i < 100; ++i) {
+    float value = static_cast<float>(i + 1) / 103.0f;
+    float once = abs_profile::AudioSample(value, 0, i);
+    EXPECT_EQ(once, abs_profile::AudioSample(once, 0, i));
+    EXPECT_EQ(std::bit_cast<uint32_t>(once) & ~3u,
+              std::bit_cast<uint32_t>(value) & ~3u);
+    differences += once != abs_profile::AudioSample(value, 927, i);
+  }
+  EXPECT_GT(differences, 0u);
+}
+
+TEST(AbsProfileTest, AudioPreservesSpecialValues) {
+  for (uint32_t bits : {0u, 0x80000000u, 1u, 0x7f800000u, 0xff800000u,
+                        0x7fc01234u}) {
+    EXPECT_EQ(bits, std::bit_cast<uint32_t>(abs_profile::AudioSample(
+                        std::bit_cast<float>(bits), 123, 0)));
+  }
+}
+
+TEST(AbsProfileTest, CanvasIsIdempotentAndDoesNotTouchPaddingOrAlpha) {
+  base::test::ScopedCommandLine command;
+  command.GetProcessCommandLine()->AppendSwitchASCII("abs-canvas-seed", "0");
+  std::array<uint8_t, 12> data = {93, 126, 167, 255, 12, 35, 68, 127,
+                                  201, 202, 203, 204};
+  const auto original = data;
+  SkPixmap pixmap(SkImageInfo::Make(2, 1, kRGBA_8888_SkColorType,
+                                   kUnpremul_SkAlphaType), data.data(), 12);
+  abs_profile::CanvasPixels(pixmap);
+  const auto once = data;
+  abs_profile::CanvasPixels(pixmap);
+  EXPECT_EQ(data, once);
+  for (size_t i = 0; i < 3; ++i)
+    EXPECT_LE(std::abs(static_cast<int>(data[i]) - original[i]), 1);
+  for (size_t i = 3; i < data.size(); ++i)
+    EXPECT_EQ(data[i], original[i]);
+}
+
+TEST(AbsProfileTest, CanvasCropUsesAbsoluteCoordinates) {
+  base::test::ScopedCommandLine command;
+  command.GetProcessCommandLine()->AppendSwitchASCII("abs-canvas-seed", "927");
+  std::array<uint8_t, 24> full;
+  for (size_t i = 0; i < full.size(); ++i)
+    full[i] = i % 4 == 3 ? 255 : 100;
+  std::array<uint8_t, 8> crop;
+  for (size_t i = 0; i < crop.size(); ++i)
+    crop[i] = full[16 + i];
+  SkPixmap all(SkImageInfo::Make(3, 2, kRGBA_8888_SkColorType,
+                               kUnpremul_SkAlphaType), full.data(), 12);
+  SkPixmap part(SkImageInfo::Make(2, 1, kRGBA_8888_SkColorType,
+                                kUnpremul_SkAlphaType), crop.data(), 8);
+  abs_profile::CanvasPixels(all);
+  abs_profile::CanvasPixels(part, 1, 1);
+  for (size_t i = 0; i < crop.size(); ++i)
+    EXPECT_EQ(full[16 + i], crop[i]);
+}
+
+TEST(AbsProfileTest, CanvasByteOrdersAgreeAndCopyOwnsItsPixels) {
+  base::test::ScopedCommandLine command;
+  command.GetProcessCommandLine()->AppendSwitchASCII("abs-canvas-seed", "23");
+  std::array<uint8_t, 4> rgba = {93, 126, 167, 255};
+  std::array<uint8_t, 4> bgra = {167, 126, 93, 255};
+  auto original = rgba;
+  SkPixmap red(SkImageInfo::Make(1, 1, kRGBA_8888_SkColorType,
+                                kUnpremul_SkAlphaType), rgba.data(), 4);
+  SkPixmap blue(SkImageInfo::Make(1, 1, kBGRA_8888_SkColorType,
+                                 kUnpremul_SkAlphaType), bgra.data(), 4);
+  auto owned = abs_profile::CanvasCopy(red);
+  ASSERT_TRUE(owned);
+  EXPECT_EQ(rgba, original);
+  abs_profile::CanvasPixels(red);
+  abs_profile::CanvasPixels(blue);
+  EXPECT_EQ(rgba[0], bgra[2]);
+  EXPECT_EQ(rgba[1], bgra[1]);
+  EXPECT_EQ(rgba[2], bgra[0]);
+  SkPixmap copy;
+  ASSERT_TRUE(owned->peekPixels(&copy));
+  EXPECT_NE(copy.addr(), red.addr());
+  const auto bytes = gfx::SkPixmapToSpan(copy);
+  for (size_t i = 0; i < rgba.size(); ++i)
+    EXPECT_EQ(bytes[i], rgba[i]);
+}
+
+}  // namespace
+}  // namespace blink
