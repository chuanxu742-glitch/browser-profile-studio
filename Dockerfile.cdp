FROM node:22-bookworm AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY src ./src
COPY tsconfig.json tsconfig.build.json ./
RUN npm run build && npm prune --omit=dev

FROM node:22-bookworm
ENV NODE_ENV=production PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY package.json ./
RUN npx playwright install --with-deps chromium && \
    mkdir -p /data/profile && chown -R node:node /data && \
    chmod -R a+rX /ms-playwright && rm -rf /var/lib/apt/lists/*
USER node
ENV CDP_HOST=0.0.0.0 CDP_PORT=9222 CDP_PROFILE_DIR=/data/profile CDP_OS=linux
EXPOSE 9222
HEALTHCHECK --interval=10s --timeout=3s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:9222/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/cdp-entrypoint.js"]
