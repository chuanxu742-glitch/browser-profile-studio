{
  "manifest_version": 3,
  "name": "Antigravity Browser Bridge",
  "version": "0.1.0",
  "description": "Connect an explicitly selected, already logged-in Chrome tab to the local Antigravity Browser control plane.",
  "permissions": [
    "activeTab",
    "alarms",
    "debugger",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Antigravity Browser Bridge",
    "default_popup": "popup.html"
  },
  "options_page": "popup.html"
}
